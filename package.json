{
  "name": "@memori.ai/ui",
  "type": "module",
  "main": "dist/memori-ai-ui.cjs.js",
  "module": "dist/memori-ai-ui.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/memori-ai-ui.es.js",
      "require": "./dist/memori-ai-ui.cjs.js"
    },
    "./style.css": "./dist/memori-ai-ui.css"
  },
  "scripts": {
    "build": "vite build",
    "lint": "bunx oxlint",
    "lint:css": "bunx stylelint \"src/**/*.css\"",
    "lint:fix": "bunx oxlint --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "test:ci": "CI=true bun test --coverage --coverage-reporter=lcov",
    "test:ai": "AGENT=1 bun test",
    "release": "bunx release-it",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@prettier/plugin-oxc": "^0.0.5",
    "@release-it/conventional-changelog": "^10.0.2",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "^1.0.0",
    "cssnano": "^7.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.30.0",
    "oxlint-tsgolint": "^0.8.2",
    "prettier": "^3.6.2",
    "release-it": "^19.0.6",
    "stylelint": "^16.26.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^39.0.1",
    "vite": "^7.2.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,tsx,css,md,json,yml,toml,yaml}": [
      "bun lint",
      "bun format:check"
    ]
  }
}
