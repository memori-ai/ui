{
  "name": "@memori.ai/ui",
  "version": "1.9.0",
  "type": "module",
  "description": "Memori.ai UI Component Library",
  "main": "./dist/memori-ai-ui.cjs.js",
  "module": "./dist/memori-ai-ui.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/memori-ai-ui.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/memori-ai-ui.es.js",
      "require": "./dist/memori-ai-ui.cjs.js"
    },
    "./styles.css": {
      "import": "./dist/memori-ai-ui.css",
      "require": "./dist/memori-ai-ui.css"
    },
    "./dist/memori-ai-ui.css": "./dist/memori-ai-ui.css"
  },
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "bunx oxlint",
    "lint:css": "bunx stylelint \"src/**/*.css\"",
    "lint:fix": "bunx oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "test": "vitest watch",
    "test:ci": "CI=true vitest run --passWithNoTests",
    "test:ai": "AGENT=1 vitest run --passWithNoTests",
    "test:husky": "CI=true vitest related --run --passWithNoTests",
    "release": "bunx release-it",
    "release:version": "bun scripts/release.ts",
    "prepare": "husky || true",
    "storybook": "storybook dev -p 6006",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@happy-dom/global-registrator": "^20.0.10",
    "@release-it/conventional-changelog": "^7.0.2",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-onboarding": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/react-vite": "^10.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.14",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "^1.0.0",
    "cssnano": "^7.1.2",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.30.0",
    "oxlint-tsgolint": "^0.8.2",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "release-it": "^19.0.6",
    "storybook": "^10.0.8",
    "stylelint": "^16.26.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^39.0.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.14",
    "vitest-browser-react": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.3.5",
    "i18next": "^25.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tanstack/react-table": "^8.21.0",
    "classnames": "^2.5.1",
    "lucide-react": "^0.555.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "memori",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/memori-ai/ui.git"
  },
  "license": "MIT"
}
